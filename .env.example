# Docker Compose automatically loads .env. Never commit real secrets.
WEB_PORT=8080
# demo uses fixed templates; live supports an OpenAI-compatible cloud API or Ollama's local /v1 endpoint.
RESEARCH_AI_MODE=demo
# Set to openai-compatible for a cloud/gateway API, or ollama for a local Ollama server.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Local mode stores data in ./data/research_agent.mv.db and generated workspaces below.
RESEARCH_WORKSPACE_ROOT=./data/workspaces
# Optional local code execution. Review generated code before approving a run.
RESEARCH_RUNNER_ENABLED=false
RESEARCH_PYTHON_EXECUTABLE=python
